# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string, using the asyncpg driver.
# Local Postgres example:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reallyrobert

# Set to "development" to enable /docs and /redoc. Leave unset (or any other
# value) in production so the API docs stay hidden.
ENVIRONMENT=development
